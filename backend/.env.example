# Backend configuration. Copy to backend/.env and fill in. Never commit backend/.env.

# HTTP port of the backend API
PORT=3001

# Local IPFS node (Kubo RPC API). Run it with: ipfs daemon --offline
IPFS_API=http://127.0.0.1:5001

# PostgreSQL (DB/setup.sh creates the hei_admin user and the hei_ecosystem database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hei_ecosystem
DB_USER=hei_admin
DB_PASSWORD=hei_local

# Local chain (yarn chain). Contract addresses are read from DEPLOYMENTS_PATH,
# by default packages/hardhat/deployments/localhost. SKILL_BADGE_ADDRESS only
# overrides it on chains with no deployment files on disk.
RPC_URL=http://127.0.0.1:8545
DEPLOYMENTS_PATH=
SKILL_BADGE_ADDRESS=

# Service keys of the bootstrap layout (deploy/02_bootstrap_roles.ts):
# oracle = Hardhat account #5, registrar = Hardhat account #6.
# Public Hardhat test keys, local chain only, never on a public network.
ORACLE_PRIVATE_KEY=0x8b3a350cf5c34c9194ca85829a2df0ec3153be0318b5e2d3348e872092edffba
REGISTRAR_PRIVATE_KEY=0x92db14e403b83dfe3df233f83dfa3a0d7096f21ca9b0d6d6b8d88b2b4ec1564e

# FenixEdu OAuth (student registration)
FENIX_CLIENT_ID=
FENIX_CLIENT_SECRET=
FENIX_REDIRECT_URI=
